# nox-mem environment configuration
# Copy to ~/.nox-mem/.env and fill in GEMINI_API_KEY (the only required value).
# Load it before running the CLI, a cron job or a service:
#   set -a; source ~/.nox-mem/.env; set +a
# (Only a shell expands $HOME. systemd EnvironmentFile / docker --env-file do not,
#  so write absolute paths there.)

# ─── Required ─────────────────────────────────────────────────────────────────

# Gemini API key (AI Studio — https://aistudio.google.com/apikey)
# Prepaid quota is per-project, not per-key. Use a key from the active billing project.
GEMINI_API_KEY=

# ─── Database (optional) ──────────────────────────────────────────────────────

# Path to the SQLite database file (created on first run). This is the default;
# a missing parent directory is created (mode 0700).
NOX_DB_PATH=$HOME/.nox-mem/nox.db

# NOT your notes folder: nothing ingests or watches it. It only decides where
# pre-operation snapshots go ($NOX_MEM_DIR/.nox-snapshots; without it they go to
# <database folder>/.nox-snapshots) and widens the op-audit path allowlist.
#NOX_MEM_DIR=

# ─── API server ───────────────────────────────────────────────────────────────

# HTTP API port (default 18802 — do NOT use 18800, Chrome squats it)
NOX_API_PORT=18802

# Bind address (default 127.0.0.1 — do NOT expose to 0.0.0.0 without auth)
NOX_API_HOST=127.0.0.1

# Bearer token for /api/* endpoints (generate with: openssl rand -hex 32)
NOX_API_TOKEN=

# ─── Multi-provider (optional) ────────────────────────────────────────────────
# Default: Gemini via AI Studio. Valid provider names: gemini, openai.
# "openai" drives ANY OpenAI-compatible endpoint (OpenAI, DeepSeek, OpenRouter,
# Together, local Ollama/vLLM). Any other name (e.g. openai-compat) is rejected.

# LLM provider for reflect / answer
#NOX_LLM_PROVIDER=openai
#NOX_LLM_BASE_URL=https://openrouter.ai/api/v1
#NOX_LLM_MODEL=deepseek/deepseek-chat
#NOX_LLM_API_KEY=

# Embedding provider. The dimension MUST be 3072: it has to equal the vec0 table,
# and changing model means re-embedding the whole corpus. text-embedding-3-large
# supports dimensions=3072; text-embedding-3-small (1536) only fits an empty database.
#NOX_EMBEDDING_PROVIDER=openai
#NOX_EMBEDDING_BASE_URL=https://api.openai.com/v1
#NOX_EMBEDDING_MODEL=text-embedding-3-large
#NOX_EMBEDDING_DIM=3072
#NOX_EMBEDDING_API_KEY=
# (NOX_EMBED_* are accepted as aliases of the NOX_EMBEDDING_* names above.)

# ─── Advanced / optional ──────────────────────────────────────────────────────

# Folders `nox-mem watch` auto-ingests: comma-separated ABSOLUTE paths. Without it
# the watcher looks at the OpenClaw layout and says "Watching 0 directories".
#NOX_WATCH_DIRS=$HOME/.nox-mem/memory

# Once the database passes 10,000 chunks, ingest/ingest-entity/watch ask you to
# confirm (or pass --allow-prod). 1 = skip that guard.
#NOX_ALLOW_PROD_INGEST=1

# Comma-separated absolute path prefixes allowed for op-audit snapshot writes
#NOX_OP_AUDIT_ALLOWED_PREFIXES=

# Directory for pre-operation snapshots
# (default <NOX_MEM_DIR or database folder>/.nox-snapshots)
#NOX_PRE_OP_SNAPSHOT_DIR=

# Comma-separated entity names that cannot be deleted without --force
#NOX_PROTECTED_NAMES=

# ⚠️ Leave OPENCLAW_WORKSPACE UNSET on a standalone install. It is the OpenClaw
# platform's workspace root. With it set and NOX_DB_PATH unset, the database moves
# to $OPENCLAW_WORKSPACE/tools/nox-mem/nox-mem.db — a different, EMPTY database
# (your notes seem to vanish), and `reindex` starts scanning that workspace.
#OPENCLAW_WORKSPACE=
